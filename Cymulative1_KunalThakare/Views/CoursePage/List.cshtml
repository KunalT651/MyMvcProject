@model IEnumerable<Course>

<h1>All Courses</h1>

<table class="table">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Course Code</th>
            <th>Teacher Id</th>
            <th>Start Date</th>
            <th>Finish Date</th>
            <th>Course Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Course in Model)
        {
            <tr>
                <td>@Course.CourseId</td>
                <td>@Course.CourseCode</td>
                <td>@Course.TeacherId</td>
                <td>@Course.StartDate</td>
                <td>@Course.FinishDate</td>
                <td>@Course.CourseName</td>
            </tr>
        }
    </tbody>
</table>